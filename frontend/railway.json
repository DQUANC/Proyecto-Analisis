{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build -- --configuration ${RAILWAY_ENVIRONMENT:-production}"
  },
  "deploy": {
    "startCommand": "node dist/frontend/server/server.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}
