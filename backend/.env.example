# Cadena de conexión a PostgreSQL (provista por el plugin Postgres de Railway)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Secreto para firmar los tokens JWT — usar una cadena aleatoria larga en todos los entornos
JWT_SECRET="cambiar_en_produccion_min_32_chars"

# Duración del token (e.g. 1d, 8h, 30m)
JWT_EXPIRES_IN="8h"

# Puerto en que escucha el servidor (Railway lo asigna automáticamente)
PORT=3000

# Lista separada por comas de orígenes de frontend permitidos para CORS
# Incluir las URLs de QA y producción si se usan múltiples entornos
FRONTEND_URL="https://tu-frontend.up.railway.app"
